# MediConnect Environment Configuration Template
# Copy this file to .env.local for local development.

NODE_ENV=development
PORT=3000

# Secret key used for signing JWT staff session cookies
JWT_SECRET=mediconnect-national-hackathon-super-secret-key-2026

# Database Connection URL (Optional for Render Postgres deployment)
# If omitted or unavailable, MediConnect automatically operates using its ACID-compliant JSON store with live persistence.
DATABASE_URL=postgresql://user:password@localhost:5432/mediconnect
